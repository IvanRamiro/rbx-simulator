+-- Element signatures ---------------------------------------------------------
+-- Extra Blender-made pieces layered on top of an element's aura (Signature in
+-- AuraStyles.Elements). Mesh pieces that haven't been imported are skipped.
+
+-- Golden Kirin: a golden lotus throne under the feet, auspicious clouds
+-- orbiting the body, soft shafts of golden light rising around it, drifting
+-- cloud puffs and jade-gold glints
+local function goldenKirinSignature(aura, look)
+    local element, tier, body = look.Element, look.Tier, aura.body
+    local size = tier.Size
+    local scale = size * body.Height / 5
+
+    local lotus = auraMesh("KirinAura_Lotus")
+    if lotus then
+        local throne = createMover(aura, "LotusThrone", CFrame.new(0, body.FeetY + 0.05, 0), 0.12)
+        attachMesh(aura, throne, lotus, CFrame.new(0, 0.35 * scale, 0), scale)
+    end
+
+    local cloud = auraMesh("KirinAura_Cloud")
+    if cloud then
+        local count = math.clamp(tier.Rings + (if tier.Crown then 1 else 0), 1, 3)
+        for index = 1, count do
+            local height = body.FeetY + body.Height * (0.3 + 0.25 * (index - 1))
+            local direction = if index % 2 == 0 then -1 else 1
+            local orbit = createMover(aura, "CloudOrbit" .. index, CFrame.new(0, height, 0), 0.35 * direction)
+            -- Out to the side, facing along its path so it drifts nose-first
+            local radius = body.Height * (0.42 + 0.06 * index)
+            local facing = if direction > 0 then 0 else math.pi
+            attachMesh(aura, orbit, cloud, CFrame.Angles(0, (index - 1) * 2.1, 0) * CFrame.new(radius, 0, 0) * CFrame.Angles(0, facing, 0), 0.6 * scale)
+        end
+    end
+
+    local shaft = elementTextures.LightShaft
+    if shaft then
+        -- Shafts of light rising around the body, slowly circling
+        local mover = createMover(aura, "LightShafts", CFrame.new(0, body.FeetY, 0), 0.2)
+        local count = 2 + math.floor(tier.Particles)
+        for index = 1, count do
+            local angle = index / count * FULL_TURN
+            local bottom = pointOnCircle(angle, body.Height * 0.36 * size, 0.2)
+            local top = pointOnCircle(angle, body.Height * 0.3 * size, body.Height * (1.1 + 0.15 * (index % 2)) * size)
+            local beam = createBeam(aura, mover.Part, createAttachment(mover.Part, bottom), createAttachment(mover.Part, top), {
+                Segments = 6,
+                Width = 1.3 * size,
+                Color = ColorSequence.new(element.Core, element.Main),
+                -- Faint at the feet, strongest low down, fading away at the top
+                Transparency = numberSequence({ { 0, 1 }, { 0.15, 0.62 }, { 0.6, 0.72 }, { 1, 1 } }),
+                LightEmission = 0.9,
+                Brightness = 1.3,
+            })
+            beam.Texture = shaft
+            beam.TextureMode = Enum.TextureMode.Stretch
+        end
+    end
+
+    -- Cloud puffs drifting up from the lotus, and jade-gold glints
+    local emitterPart = createMover(aura, "KirinParticles", CFrame.new(0, body.FeetY + body.Height * 0.45, 0), 0,
+        0, Vector3.new(body.Height * 0.55, body.Height * 0.9, body.Height * 0.55) * size).Part
+    if elementTextures.KirinCloud then
+        createEmitter(aura, emitterPart, 1.2 * tier.Particles, {
+            Texture = elementTextures.KirinCloud,
+            Color = ColorSequence.new(element.Core),
+            LightEmission = 0.3,
+            Brightness = 1.4,
+            Size = numberSequence({ { 0, 0 }, { 0.2, 0.9 * size }, { 1, 1.4 * size } }),
+            Transparency = numberSequence({ { 0, 1 }, { 0.2, 0.35 }, { 0.75, 0.55 }, { 1, 1 } }),
+            Lifetime = NumberRange.new(2.5, 3.5),
+            Speed = NumberRange.new(0.5, 1.1),
+            EmissionDirection = Enum.NormalId.Top,
+            SpreadAngle = Vector2.new(15, 15),
+            Rotation = NumberRange.new(-10, 10),
+            RotSpeed = NumberRange.new(-8, 8),
+        })
+    end
+    if elementTextures.KirinGlint then
+        createEmitter(aura, emitterPart, 3 * tier.Particles, {
+            Texture = elementTextures.KirinGlint,
+            Color = ColorSequence.new(element.Core, element.Main),
+            LightEmission = 0.6,
+            Brightness = 2.5,
+            Size = numberSequence({ { 0, 0 }, { 0.35, 0.9 * size }, { 1, 0 } }),
+            Lifetime = NumberRange.new(0.6, 1.1),
+            Speed = NumberRange.new(0, 0.3),
+            SpreadAngle = Vector2.new(180, 180),
+            Rotation = NumberRange.new(0, 45),
+        })
+    end
+end
+
