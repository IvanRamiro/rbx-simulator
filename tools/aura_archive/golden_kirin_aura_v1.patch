+    -- behind it (the root part faces -Z). Sway rocks it gently.
+    local haloY = body.HeadTopY - 0.12 * body.Height
+    local mover = createMover(aura, "AntlerHalo", CFrame.new(0, haloY + 0.55 * scale, 0.7), 0, 6)
+    attachMesh(aura, mover, template, CFrame.identity, scale)
+end
