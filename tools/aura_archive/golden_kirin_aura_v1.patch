+-- Imported Blender meshes ------------------------------------------------
+
+-- Aura pieces modelled in Blender (tools/blender/GoldenKirinAura.blend),
+-- exported to assets/aura/<element>/*.fbx and imported with Studio's 3D
+-- Importer into ReplicatedStorage.AuraMeshes, keeping their file names.
+-- "<Name>_Glow_<rrggbb>" parts glow as Neon in that colour.
+local function auraMesh(name)
+    local folder = ReplicatedStorage:FindFirstChild("AuraMeshes")
+    local model = folder and folder:FindFirstChild(name)
+    return if model and model:IsA("Model") then model else nil
+end
+
+-- Clones an imported model onto a mover, centred at `offset` from it and
+-- scaled by `scale`, fading in with the aura. The aura's model must not be
+-- parented yet: the welds keep these offsets once it is.
+local function attachMesh(aura, mover, template, offset, scale)
+    local boxCFrame = template:GetBoundingBox()
+    local parts = {}
+    for _, piece in template:GetDescendants() do
+        if not piece:IsA("BasePart") then
+            continue
+        end
+        local part = piece:Clone()
+        local hex = string.match(piece.Name, "_Glow_(%x%x%x%x%x%x)$")
+        for _, child in part:GetChildren() do
+            if hex or not child:IsA("SurfaceAppearance") then
+                child:Destroy()
+            end
+        end
+        if hex then
+            part.Color = Color3.fromHex(hex)
+            part.Material = Enum.Material.Neon
+            if part:IsA("MeshPart") then
+                part.TextureID = ""
+            end
+        end
+        local relative = CFrame.new(-boxCFrame.Position) * piece.CFrame
+        part.Size = piece.Size * scale
+        part.CFrame = mover.Part.CFrame * offset * (relative.Rotation + relative.Position * scale)
+        part.Anchored = false
+        part.CanCollide = false
+        part.CanQuery = false
+        part.CanTouch = false
+        part.CastShadow = false
+        part.Massless = true
+        local weld = Instance.new("WeldConstraint")
+        weld.Part0 = mover.Part
+        weld.Part1 = part
+        weld.Parent = part
+        part.Parent = aura.model
+        addFade(aura, part, "Transparency", 0, 1)
+        table.insert(parts, part)
+    end
+    return parts
+end
